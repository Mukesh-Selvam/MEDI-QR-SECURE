{
  "name": "@mediqr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seeds/dev-seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "provision:dev-clinician": "tsx src/database/provision-dev-clinician.ts",
    "audit:verify": "tsx src/modules/audit/verify-audit-chain.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "pnpm db:migrate && vitest run --config vitest.int.config.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@cerbos/core": "^0.33.1",
    "@cerbos/grpc": "^0.29.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "10.1.2",
    "@mediqr/schemas": "workspace:*",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^11.0.10",
    "@nestjs/swagger": "^11.0.5",
    "@types/nodemailer": "^8.0.2",
    "bullmq": "^6.3.11",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@mediqr/config": "workspace:*",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.1",
    "fast-glob": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
