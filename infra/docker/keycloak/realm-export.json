{
  "realm": "mediqr",
  "enabled": true,
  "displayName": "MediQR Secure",
  "displayNameHtml": "<b>MediQR</b> Secure",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 3600,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "patient", "composite": false, "clientRole": false },
      { "name": "guardian", "composite": false, "clientRole": false },
      { "name": "clinician", "composite": false, "clientRole": false },
      { "name": "facility-admin", "composite": false, "clientRole": false },
      { "name": "pharmacy-staff", "composite": false, "clientRole": false },
      { "name": "platform-admin", "composite": false, "clientRole": false }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    }
  ],
  "browserFlow": "mediqr-browser-mfa",
  "authenticationFlows": [
    {
      "alias": "mediqr-browser-mfa",
      "description": "Browser authentication requiring a password and an enrolled MFA method",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "mediqr-browser-forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "mediqr-browser-forms",
      "description": "Username and password followed by mandatory TOTP or WebAuthn",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-forms",
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 20,
          "flowAlias": "mediqr-mfa",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "mediqr-mfa",
      "description": "Complete either TOTP or WebAuthn authentication",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": true,
          "authenticatorConfig": "mediqr-webauthn-amr"
        },
        {
          "authenticator": "auth-forms",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "mediqr-mfa-totp"
        }
      ]
    },
    {
      "alias": "mediqr-mfa-totp",
      "description": "Require TOTP and enroll users who do not have a factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": true,
          "authenticatorConfig": "mediqr-otp-amr"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "mediqr-otp-amr",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "300"
      }
    },
    {
      "alias": "mediqr-webauthn-amr",
      "config": {
        "default.reference.value": "webauthn",
        "default.reference.maxAge": "300"
      }
    }
  ],
  "clients": [
  {
    "clientId": "mediqr-web",
    "name": "MediQR Web Application",
    "enabled": true,
    "publicClient": true,
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "redirectUris": ["http://localhost:3000/api/auth/callback"],
    "webOrigins": ["http://localhost:3000"],
    "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
    "optionalClientScopes": [],
    "protocolMappers": [
      {
        "name": "MediQR authentication methods",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-amr-mapper",
        "consentRequired": false,
        "config": {
          "access.token.claim": "true",
          "id.token.claim": "false"
        }
      }
    ],
    "attributes": {
      "pkce.code.challenge.method": "S256",
      "post.logout.redirect.uris": "http://localhost:3000/",
      "access.token.lifespan": "300"
    }
  }
  ],
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "REGISTER", "REGISTER_ERROR",
    "UPDATE_PASSWORD", "UPDATE_PASSWORD_ERROR", "RESET_PASSWORD", "RESET_PASSWORD_ERROR",
    "REFRESH_TOKEN", "REFRESH_TOKEN_ERROR"
  ]
}
