{
  "name": "mediqr-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:setup": "pnpm --filter @mediqr/api db:setup",
    "test": "turbo run test",
    "test:int": "pnpm --filter @mediqr/api test:int",
    "test:e2e": "pnpm --filter @mediqr/web test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky || true",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:stop": "docker compose stop",
    "infra:start": "docker compose start",
    "infra:ps": "docker compose ps",
    "infra:logs": "docker compose logs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
