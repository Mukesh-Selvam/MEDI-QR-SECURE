# ==============================================================================
# MEDIQR SECURE — ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Security Policy:
# 1. Never commit actual secret values to version control.
# 2. In production, load secrets from a verified Secrets Manager (e.g., AWS Secrets
#    Manager, HashiCorp Vault) or KMS-backed injection.
# 3. Deny by default: Ensure all keys have strict, non-default values in staging/prod.
#
# Generating Strong Dev Secrets:
# - 256-bit Hex Keys (MASTER_ENCRYPTION_KEY):
#     openssl rand -hex 32
#     node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# - High-Entropy Passwords & JWT Secrets:
#     openssl rand -base64 32
#     node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# Service Ports & Domains
PORT_API=3001
PORT_WEB=3000
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediqr_db
DB_USER=mediqr_user
DB_PASSWORD=mediqr_secure_dev_password_do_not_use_in_prod
DATABASE_URL=postgresql://mediqr_user:mediqr_secure_dev_password_do_not_use_in_prod@localhost:5432/mediqr_db
DB_SSL_ENABLED=false
DB_MAX_CONNECTIONS=20

# Cache & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mediqr_redis_dev_password

# Object Storage (MinIO / S3 SSE-KMS)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=mediqr_minio_admin
STORAGE_SECRET_KEY=mediqr_minio_dev_secret_key_change_me
STORAGE_BUCKET_DOCUMENTS=mediqr-documents
STORAGE_REGION=ap-south-1

# Antivirus Scanning (ClamAV daemon)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=15000

# Identity Provider (Keycloak OIDC)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=mediqr
KEYCLOAK_CLIENT_ID=mediqr-web
# Next.js server-side staff OIDC callback and API session lookup
WEB_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<replace-with: openssl rand -base64 24>

# Cerbos Policy Decision Point
CERBOS_HOST=localhost
CERBOS_PORT=3593

# Cryptography & Security Keys
# Note: MASTER_ENCRYPTION_KEY must be a 256-bit hex-encoded key (32 bytes = 64 hex characters)
# For dev only. In production this key is derived from an AWS KMS HSM or CloudHSM.
MASTER_ENCRYPTION_KEY=<replace-with: openssl rand -hex 32>
JWT_ACCESS_SECRET=<replace-with: openssl rand -base64 32>
JWT_REFRESH_SECRET=<replace-with: openssl rand -base64 32>
HMAC_QR_SIGNING_KEY=<replace-with: openssl rand -base64 32>
# Session signing key (CSRF HMAC + access token signing in dev). Min 32 chars.
SESSION_SECRET=<replace-with: openssl rand -base64 32>
# HMAC key for IP address hashing in audit logs. Min 32 chars.
AUDIT_HMAC_KEY=<replace-with: openssl rand -base64 32>

# Notification & Mailer (Mailpit for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@mediqr.internal

# Observability (OpenTelemetry Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=mediqr-platform
